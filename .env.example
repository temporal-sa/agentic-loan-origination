# ===================================================================
# TEMPORAL WORKFLOW ORCHESTRATION
# ===================================================================
# For local: TEMPORAL_ADDRESS=localhost:7233, TEMPORAL_NAMESPACE=default
# For cloud: TEMPORAL_ADDRESS=your-namespace.account-id.tmprl.cloud:7233, TEMPORAL_NAMESPACE=your-namespace.account-id
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=loan-underwriter-queue

# Optional: Temporal Cloud API Key (if not set, connects without authentication for local)
# TEMPORAL_API_KEY=your-api-key-here

# ===================================================================
# LLM MODEL PROVIDER
# ===================================================================
MODEL_PROVIDER=aws-bedrock # either 'ollama' or 'aws-bedrock'

# Ollama Settings (for local development)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# AWS Bedrock Settings (for Strands agents and aggregate_and_decide activity)
AWS_PROFILE=bedrock-role
AWS_BEARER_TOKEN_BEDROCK=<your-bedrock-api-key>
AWS_REGION=ap-southeast-2
AWS_BEDROCK_MODEL=au.anthropic.claude-sonnet-4-5-20250929-v1:0

# ===================================================================
# AWS BEDROCK DATA AUTOMATION (Step 2: Document OCR)
# ===================================================================
# Required for fetch_documents activity to extract data from uploaded documents
# Create a BDA project with these blueprints:
#   - bedrock-data-automation-public-bank-statement
#   - bedrock-data-automation-public-us-driver-license
#   - bedrock-data-automation-public-payslip
#   - bedrock-data-automation-public-us-bank-check (optional)

BEDROCK_DATA_AUTOMATION_PROJECT_ARN=arn:aws:bedrock:ap-southeast-2:123456789012:data-automation-project/your-project-name

# S3 bucket for temporary document storage during BDA processing
# Will be automatically cleaned up after extraction
AWS_S3_BUCKET=your-loan-underwriter-bucket

# ===================================================================
# AWS AGENTCORE CODE INTERPRETER (Step 3: Financial Analysis)
# ===================================================================
# AgentCore Code Interpreter is automatically configured via the region
# Ensure your IAM role has these permissions:
#   - bedrock:InvokeAgent
#   - bedrock:InvokeCodeInterpreter
#   - bedrock:GetAgentRuntimeSession

# The region should match your Bedrock setup above
# AWS_REGION is already set above

# ===================================================================
# SETUP INSTRUCTIONS
# ===================================================================
# 1. Create a Bedrock Data Automation Project:
#    - Go to AWS Console → Bedrock → Data Automation
#    - Create new project with name "loan-underwriter-bda"
#    - Add public blueprints: bank-statement, us-driver-license, payslip
#    - Copy the project ARN to BEDROCK_DATA_AUTOMATION_PROJECT_ARN above
#
# 2. Create an S3 bucket:
#    - Go to AWS Console → S3
#    - Create bucket (e.g., "loan-underwriter-docs-<account-id>")
#    - Enable versioning (optional)
#    - Copy bucket name to AWS_S3_BUCKET above
#
# 3. Configure IAM permissions:
#    Your AWS credentials need these policies:
#    - AmazonBedrockFullAccess (or custom policy with bedrock:*)
#    - AmazonS3FullAccess (or custom policy for your bucket)
#    - Custom policy for Bedrock Data Automation:
#      {
#        "Version": "2012-10-17",
#        "Statement": [{
#          "Effect": "Allow",
#          "Action": [
#            "bedrock-data-automation:InvokeDataAutomationAsync",
#            "bedrock-data-automation:GetDataAutomationStatus",
#            "bedrock-data-automation-runtime:*"
#          ],
#          "Resource": "*"
#        }]
#      }
#
# 4. Set up AWS credentials (one of these methods):
#    - AWS CLI: Run `aws configure` and enter your credentials
#    - Environment variables: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
#    - IAM role (if running on EC2/ECS)
#
# 5. Install dependencies:
#    pip install -r requirements.txt
#
# 6. Test the integration:
#    - Start Temporal: temporal server start-dev
#    - Start worker: python -m backend.worker
#    - Start API: uvicorn backend.main:app --reload
#    - Start UI: streamlit run ui/streamlit_app.py