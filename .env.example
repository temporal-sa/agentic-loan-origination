# ===================================================================
# TEMPORAL WORKFLOW ORCHESTRATION
# ===================================================================
# For local: TEMPORAL_ADDRESS=localhost:7233, TEMPORAL_NAMESPACE=default
# For cloud: TEMPORAL_ADDRESS=your-namespace.account-id.tmprl.cloud:7233, TEMPORAL_NAMESPACE=your-namespace.account-id
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=loan-underwriter-queue

# Optional: Temporal Cloud API Key (if not set, connects without authentication for local)
# TEMPORAL_API_KEY=your-api-key-here

# ===================================================================
# LLM MODEL PROVIDER
# ===================================================================
MODEL_PROVIDER=aws-bedrock # either 'ollama' or 'aws-bedrock'

# Ollama Settings (for local development)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_VISION_MODEL=granite3.2-vision:latest

# AWS Bedrock Settings (for Strands agents and aggregate_and_decide activity)
AWS_PROFILE=bedrock-role
AWS_BEARER_TOKEN_BEDROCK=<your-bedrock-api-key>
AWS_REGION=ap-southeast-2
AWS_BEDROCK_MODEL=au.anthropic.claude-sonnet-4-5-20250929-v1:0

# ===================================================================
# OLLAMA GRANITE3.2-VISION (Step 2: Document OCR)
# ===================================================================
# Required for document processing activity to extract data from uploaded documents
# Uses Ollama granite3.2-vision model running locally via Strands
# Note: Uses same OLLAMA_URL configured above

# Install granite3.2-vision model:
#   ollama pull granite3.2-vision:latest
# Supported document types:
#   - bank_statement (extracts account info and transactions)
#   - salary_slip / proof_of_income (extracts salary and deductions)
#   - id_proof / proof_of_id (extracts US driver's license information)

# ===================================================================
# AWS AGENTCORE CODE INTERPRETER (Step 3: Financial Analysis)
# ===================================================================
# AgentCore Code Interpreter is automatically configured via the region
# Ensure your IAM role has these permissions:
#   - bedrock:InvokeAgent
#   - bedrock:InvokeCodeInterpreter
#   - bedrock:GetAgentRuntimeSession

# The region should match your Bedrock setup above
# AWS_REGION is already set above

# ===================================================================
# SETUP INSTRUCTIONS
# ===================================================================
# 1. Install Ollama (for local LLM and vision model):
#    - Download from: https://ollama.ai
#    - Install granite3.2-vision: ollama pull granite3.2-vision:latest
#    - Install LLM model: ollama pull llama3:latest (or your preferred model)
#
# 2. Configure AWS credentials for AgentCore Code Interpreter (optional):
#    Your AWS credentials need these policies for financial analysis:
#    - Custom policy for Bedrock AgentCore:
#      {
#        "Version": "2012-10-17",
#        "Statement": [{
#          "Effect": "Allow",
#          "Action": [
#            "bedrock:InvokeAgent",
#            "bedrock:InvokeCodeInterpreter",
#            "bedrock:GetAgentRuntimeSession"
#          ],
#          "Resource": "*"
#        }]
#      }
#
#    Set up AWS credentials (one of these methods):
#    - AWS CLI: Run `aws configure` and enter your credentials
#    - Environment variables: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
#    - IAM role (if running on EC2/ECS)
#
# 3. Install Python dependencies:
#    pip install -r requirements.txt
#
# 4. Start the services:
#    - Start Temporal: temporal server start-dev
#    - Start mock APIs: node backend/mockapis.js (in separate terminal)
#    - Start worker: python -m backend.worker
#    - Start API: uvicorn backend.main:app --reload
#    - Start UI: streamlit run ui/streamlit_app.py
#
# 5. Test document OCR:
#    - Upload documents through the UI
#    - granite3.2-vision will process them locally
#    - Extracted JSON saved to backend/uploads/<applicant-id>/